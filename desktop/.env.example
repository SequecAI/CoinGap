# Google Cloud Console → APIs & Services → Credentials
# → "Create OAuth client ID" → Application type: "Desktop app"
# 만든 뒤 client_id / client_secret을 이 파일을 복사한 .env에 채워넣으세요.
#
# Desktop OAuth는 "public client"라 secret이 진짜 비밀이 아니지만,
# Google 표준 token-exchange가 secret 전송을 요구해 여전히 필요합니다.

GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
