{
  "rewrites": [
    {
      "source": "/naver-fchart/:path*",
      "destination": "https://fchart.stock.naver.com/:path*"
    },
    {
      "source": "/naver-api/:path*",
      "destination": "https://m.stock.naver.com/:path*"
    },
    {
      "source": "/upbit-api/:path*",
      "destination": "https://api.upbit.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
